<!DOCTYPE html>
<html lang="ar" dir="rtl" id="app">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#b42318">

  <title>بوابة الطوارئ الميدانية | مشروع الدرعية</title>
  <meta name="description" content="بوابة الاستجابة للطوارئ الميدانية لمشروع الدرعية">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&family=Noto+Naskh+Arabic:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --red: #b42318;
      --red-dark: #8f1d14;
      --red-soft: #fff1f0;
      --green: #087443;
      --green-soft: #ecfdf3;
      --orange: #c2410c;
      --blue: #175cd3;
      --ink: #101828;
      --muted: #667085;
      --line: #e4e7ec;
      --bg: #f8fafc;
      --white: #ffffff;
      --shadow: 0 12px 35px rgba(16, 24, 40, .08);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--ink);
      font-family: "Cairo", sans-serif;
      line-height: 1.65;
    }

    html[lang="en"] body {
      font-family: "Inter", sans-serif;
    }

    html[lang="ur"] body {
      font-family: "Noto Naskh Arabic", serif;
    }

    button,
    input,
    select {
      font: inherit;
    }

    button,
    a {
      -webkit-tap-highlight-color: transparent;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* =========================
       LANGUAGE SPLASH
    ========================= */

    #languageSplash {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background:
        radial-gradient(circle at 20% 20%, rgba(180,35,24,.14), transparent 35%),
        radial-gradient(circle at 80% 80%, rgba(8,116,67,.12), transparent 35%),
        #f8fafc;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      transition: opacity .3s ease, visibility .3s ease;
    }

    #languageSplash.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .splash-card {
      width: min(480px, 100%);
      background: rgba(255,255,255,.96);
      border: 1px solid var(--line);
      border-radius: 28px;
      padding: 34px 26px;
      box-shadow: 0 25px 80px rgba(16,24,40,.14);
      text-align: center;
    }

    .logo {
      width: 82px;
      height: 82px;
      margin: 0 auto 18px;
      border-radius: 24px;
      display: grid;
      place-items: center;
      background: linear-gradient(145deg, var(--red), #e5484d);
      color: white;
      font-size: 40px;
      box-shadow: 0 15px 30px rgba(180,35,24,.25);
    }

    .splash-card h1 {
      font-size: clamp(22px, 5vw, 30px);
      line-height: 1.3;
      margin-bottom: 8px;
    }

    .splash-card p {
      color: var(--muted);
      margin-bottom: 24px;
    }

    .language-buttons {
      display: grid;
      gap: 12px;
    }

    .language-btn {
      min-height: 62px;
      border: 1px solid var(--line);
      background: white;
      border-radius: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      font-size: 18px;
      font-weight: 700;
      transition: .2s ease;
    }

    .language-btn:hover,
    .language-btn:focus {
      transform: translateY(-2px);
      border-color: var(--red);
      box-shadow: 0 8px 20px rgba(180,35,24,.12);
    }

    .language-btn.ar:hover { background: #fff7f6; }
    .language-btn.en:hover { background: #f5f8ff; }
    .language-btn.ur:hover { background: #f5fff9; }

    /* =========================
       HEADER
    ========================= */

    .top-alert {
      background: var(--red);
      color: white;
      padding: 10px 16px;
      text-align: center;
      font-weight: 700;
      font-size: 14px;
    }

    .top-alert a {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin-inline-start: 8px;
      padding: 3px 12px;
      border: 1px solid rgba(255,255,255,.65);
      border-radius: 999px;
      background: rgba(0,0,0,.12);
    }

    header {
      position: sticky;
      top: 0;
      z-index: 1000;
      background: rgba(255,255,255,.94);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line);
    }

    .nav {
      width: min(1180px, calc(100% - 32px));
      min-height: 76px;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      font-weight: 800;
      white-space: nowrap;
    }

    .brand-mark {
      width: 44px;
      height: 44px;
      border-radius: 13px;
      background: var(--red);
      color: white;
      display: grid;
      place-items: center;
      font-size: 22px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 24px;
      color: #475467;
      font-size: 14px;
      font-weight: 600;
    }

    .nav-links a:hover {
      color: var(--red);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .lang-select {
      border: 1px solid var(--line);
      background: white;
      border-radius: 10px;
      padding: 8px 10px;
      cursor: pointer;
    }

    .mobile-menu {
      display: none;
      border: 0;
      background: #f2f4f7;
      width: 42px;
      height: 42px;
      border-radius: 10px;
      cursor: pointer;
      font-size: 21px;
    }

    /* =========================
       HERO
    ========================= */

    .hero {
      width: min(1180px, calc(100% - 32px));
      margin: 38px auto 0;
      border-radius: 28px;
      overflow: hidden;
      position: relative;
      background:
        linear-gradient(120deg, rgba(16,24,40,.96), rgba(16,24,40,.76)),
        radial-gradient(circle at 80% 20%, #b42318, transparent 35%);
      color: white;
    }

    .hero-inner {
      padding: clamp(32px, 7vw, 72px);
      max-width: 850px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(255,255,255,.1);
      border: 1px solid rgba(255,255,255,.16);
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 13px;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-size: clamp(30px, 6vw, 54px);
      line-height: 1.15;
      margin-bottom: 18px;
    }

    .hero p {
      color: #d0d5dd;
      font-size: clamp(15px, 2vw, 18px);
      max-width: 700px;
      margin-bottom: 28px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .btn {
      min-height: 48px;
      padding: 10px 18px;
      border: 0;
      border-radius: 12px;
      cursor: pointer;
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: .2s ease;
    }

    .btn:hover {
      transform: translateY(-2px);
    }

    .btn-danger {
      background: var(--red);
      color: white;
    }

    .btn-white {
      background: white;
      color: var(--ink);
    }

    .btn-green {
      background: var(--green);
      color: white;
    }

    .btn-outline {
      background: transparent;
      color: var(--ink);
      border: 1px solid var(--line);
    }

    /* =========================
       GENERAL
    ========================= */

    .container {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
    }

    section {
      padding-top: 58px;
      scroll-margin-top: 95px;
    }

    .section-head {
      margin-bottom: 22px;
    }

    .section-head h2 {
      font-size: clamp(22px, 4vw, 30px);
      line-height: 1.25;
      margin-bottom: 7px;
    }

    .section-head p {
      color: var(--muted);
    }

    /* =========================
       QUICK STATS
    ========================= */

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-top: 18px;
    }

    .stat {
      background: white;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 20px;
      box-shadow: var(--shadow);
    }

    .stat strong {
      display: block;
      font-size: 25px;
      color: var(--red);
    }

    .stat span {
      color: var(--muted);
      font-size: 13px;
    }

    /* =========================
       EMERGENCY CASES
    ========================= */

    .case-tools {
      display: flex;
      gap: 10px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }

    .search {
      flex: 1;
      min-width: 220px;
      position: relative;
    }

    .search input {
      width: 100%;
      height: 48px;
      padding: 0 16px;
      border: 1px solid var(--line);
      border-radius: 12px;
      outline: none;
      background: white;
    }

    .search input:focus {
      border-color: var(--red);
      box-shadow: 0 0 0 4px rgba(180,35,24,.08);
    }

    .filter {
      height: 48px;
      padding: 0 13px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: white;
      cursor: pointer;
    }

    .cases-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }

    .case-card {
      background: white;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 18px;
      cursor: pointer;
      transition: .22s ease;
      box-shadow: 0 4px 14px rgba(16,24,40,.04);
      position: relative;
      overflow: hidden;
    }

    .case-card::after {
      content: "";
      position: absolute;
      inset-inline-end: -30px;
      bottom: -35px;
      width: 90px;
      height: 90px;
      background: var(--red-soft);
      border-radius: 50%;
    }

    .case-card:hover {
      transform: translateY(-4px);
      border-color: #f1a8a4;
      box-shadow: 0 14px 30px rgba(16,24,40,.1);
    }

    .case-icon {
      width: 50px;
      height: 50px;
      display: grid;
      place-items: center;
      border-radius: 14px;
      background: var(--red-soft);
      font-size: 25px;
      margin-bottom: 13px;
    }

    .case-card h3 {
      font-size: 16px;
      margin-bottom: 5px;
      position: relative;
      z-index: 1;
    }

    .case-card small {
      color: var(--muted);
      position: relative;
      z-index: 1;
    }

    .no-results {
      background: white;
      border: 1px dashed var(--line);
      border-radius: 16px;
      padding: 35px;
      text-align: center;
      color: var(--muted);
      grid-column: 1/-1;
    }

    /* =========================
       CONTACTS
    ========================= */

    .contacts-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .contact-card {
      background: white;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 18px;
      box-shadow: 0 4px 14px rgba(16,24,40,.04);
    }

    .contact-role {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 4px;
    }

    .contact-name {
      font-weight: 800;
      margin-bottom: 12px;
    }

    .call {
      width: 100%;
      min-height: 44px;
      border-radius: 10px;
      background: var(--green);
      color: white;
      display: flex;
      justify-content: center;
      align-items: center;
      font-weight: 800;
    }

    /* =========================
       INFO CARDS
    ========================= */

    .info-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .info-card {
      background: white;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 22px;
    }

    .info-card .icon {
      font-size: 28px;
      margin-bottom: 10px;
    }

    .info-card h3 {
      margin-bottom: 7px;
    }

    .info-card p {
      color: var(--muted);
      font-size: 14px;
    }

    /* =========================
       FOOTER
    ========================= */

    footer {
      margin-top: 70px;
      padding: 35px 0;
      background: #101828;
      color: white;
    }

    .footer-inner {
      width: min(1180px, calc(100% - 32px));
      margin: auto;
      display: flex;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
    }

    .footer-inner p {
      color: #98a2b3;
      font-size: 13px;
    }

    /* =========================
       MODAL
    ========================= */

    .modal {
      position: fixed;
      inset: 0;
      background: rgba(16,24,40,.68);
      backdrop-filter: blur(5px);
      z-index: 5000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 18px;
    }

    .modal.open {
      display: flex;
    }

    .modal-box {
      width: min(650px, 100%);
      max-height: 90vh;
      overflow-y: auto;
      background: white;
      border-radius: 22px;
      padding: 24px;
      position: relative;
      animation: modalIn .2s ease;
    }

    @keyframes modalIn {
      from { opacity: 0; transform: translateY(15px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .modal-close {
      position: absolute;
      inset-inline-end: 14px;
      top: 14px;
      border: 0;
      background: #f2f4f7;
      width: 38px;
      height: 38px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 20px;
    }

    .modal-title {
      padding-inline-end: 45px;
      color: var(--red);
      font-size: 23px;
      margin-bottom: 15px;
    }

    .location-box {
      background: var(--green-soft);
      border: 1px solid #abefc6;
      border-radius: 12px;
      padding: 13px;
      margin-bottom: 18px;
    }

    .modal-section-title {
      margin: 18px 0 8px;
    }

    .steps {
      padding-inline-start: 22px;
    }

    .steps li {
      margin-bottom: 8px;
    }

    .kit-list {
      display: grid;
      gap: 7px;
    }

    .kit-item {
      padding: 10px 12px;
      background: #f8fafc;
      border: 1px solid var(--line);
      border-radius: 9px;
    }

    .modal-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 9px;
      margin-top: 22px;
    }

    /* =========================
       MOBILE
    ========================= */

    @media (max-width: 900px) {
      .nav-links {
        display: none;
        position: absolute;
        top: 76px;
        inset-inline: 16px;
        background: white;
        padding: 15px;
        border: 1px solid var(--line);
        border-radius: 15px;
        box-shadow: var(--shadow);
        flex-direction: column;
        align-items: stretch;
        gap: 0;
      }

      .nav-links.open {
        display: flex;
      }

      .nav-links a {
        padding: 13px;
        border-bottom: 1px solid #f2f4f7;
      }

      .mobile-menu {
        display: block;
      }

      .cases-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .contacts-grid,
      .info-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 600px) {
      .nav {
        width: min(100% - 20px, 1180px);
        min-height: 68px;
      }

      .brand span {
        display: none;
      }

      .nav-actions .lang-select {
        max-width: 90px;
      }

      .hero {
        width: calc(100% - 20px);
        margin-top: 20px;
        border-radius: 20px;
      }

      .container {
        width: calc(100% - 20px);
      }

      section {
        padding-top: 42px;
      }

      .cases-grid {
        grid-template-columns: 1fr 1fr;
        gap: 9px;
      }

      .case-card {
        padding: 14px;
      }

      .case-icon {
        width: 43px;
        height: 43px;
        font-size: 21px;
      }

      .case-card h3 {
        font-size: 14px;
      }

      .case-card small {
        font-size: 11px;
      }

      .stats,
      .contacts-grid,
      .info-grid {
        grid-template-columns: 1fr;
      }

      .modal-actions {
        grid-template-columns: 1fr;
      }

      .top-alert {
        font-size: 12px;
      }

      .top-alert a {
        display: block;
        width: max-content;
        margin: 5px auto 0;
      }
    }
  </style>
</head>

<body>

<!-- =========================
     LANGUAGE SPLASH
========================= -->

<div id="languageSplash">
  <div class="splash-card">
    <div class="logo">🚨</div>

    <h1>بوابة الاستجابة للطوارئ</h1>
    <p>اختر اللغة للمتابعة<br>Choose your language</p>

    <div class="language-buttons">
      <button class="language-btn ar" onclick="setLanguage('ar')">
        🇸🇦 العربية
      </button>

      <button class="language-btn en" onclick="setLanguage('en')">
        🇬🇧 English
      </button>

      <button class="language-btn ur" onclick="setLanguage('ur')">
        🇵🇰 اردو
      </button>
    </div>
  </div>
</div>

<!-- =========================
     EMERGENCY BAR
========================= -->

<div class="top-alert">
  <span data-i18n="hotline">خط الطوارئ 24/7</span>
  <a href="tel:0501160516">📞 050 116 0516</a>
</div>

<!-- =========================
     HEADER
========================= -->

<header>
  <nav class="nav">

    <a href="#home" class="brand">
      <div class="brand-mark">🚨</div>
      <span data-i18n="brand">بوابة الطوارئ | مشروع الدرعية</span>
    </a>

    <div class="nav-links" id="navLinks">
      <a href="#home" data-i18n="navHome">الرئيسية</a>
      <a href="#cases" data-i18n="navCases">حالات الطوارئ</a>
      <a href="#contacts" data-i18n="navContacts">جهات الاتصال</a>
      <a href="#about" data-i18n="navAbout">عن البوابة</a>
    </div>

    <div class="nav-actions">
      <select class="lang-select" id="languageSelect" onchange="setLanguage(this.value)" aria-label="Language">
        <option value="ar">🇸🇦 العربية</option>
        <option value="en">🇬🇧 English</option>
        <option value="ur">🇵🇰 اردو</option>
      </select>

      <button class="mobile-menu" onclick="toggleMenu()" aria-label="Menu">
        ☰
      </button>
    </div>

  </nav>
</header>

<main>

  <!-- =========================
       HERO
  ========================= -->

  <section id="home" class="hero">
    <div class="hero-inner">

      <div class="eyebrow">
        🔴 <span data-i18n="livePortal">بوابة طوارئ ميدانية</span>
      </div>

      <h1 data-i18n="heroTitle">
        استجابة أسرع.<br>
        قرار أكثر أماناً.
      </h1>

      <p data-i18n="heroText">
        منصة ميدانية مبسطة للوصول السريع إلى إجراءات الطوارئ،
        فرق الاستجابة وأرقام الاتصال المهمة داخل المشروع.
      </p>

      <div class="hero-actions">
        <a href="#cases" class="btn btn-danger">
          🚨 <span data-i18n="viewCases">عرض حالات الطوارئ</span>
        </a>

        <a href="tel:0501160516" class="btn btn-white">
          📞 <span data-i18n="callEmergency">اتصال بالطوارئ</span>
        </a>
      </div>

    </div>
  </section>

  <div class="container">

    <!-- =========================
         STATS
    ========================= -->

    <section>
      <div class="stats">

        <div class="stat">
          <strong>16</strong>
          <span data-i18n="statCases">حالة طوارئ رئيسية</span>
        </div>

        <div class="stat">
          <strong>24/7</strong>
          <span data-i18n="statAvailability">استجابة على مدار الساعة</span>
        </div>

        <div class="stat">
          <strong>3</strong>
          <span data-i18n="statLanguages">لغات متاحة</span>
        </div>

        <div class="stat">
          <strong>1-TAP</strong>
          <span data-i18n="statCall">اتصال سريع</span>
        </div>

      </div>
    </section>

    <!-- =========================
         EMERGENCY CASES
    ========================= -->

    <section id="cases">

      <div class="section-head">
        <h2 data-i18n="casesTitle">
          حالات الطوارئ والإبلاغ المباشر
        </h2>

        <p data-i18n="casesSubtitle">
          اختر الحالة للحصول على إرشادات الاستجابة الأولية.
        </p>
      </div>

      <div class="case-tools">

        <div class="search">
          <input
            id="searchInput"
            type="search"
            oninput="filterCases()"
            placeholder="ابحث عن حالة..."
            aria-label="Search cases"
          >
        </div>

        <select id="caseFilter" class="filter" onchange="filterCases()">
          <option value="all" data-i18n="allCases">كل الحالات</option>
          <option value="fire" data-i18n="filterFire">حريق / انفجار</option>
          <option value="medical" data-i18n="filterMedical">إصابات طبية</option>
          <option value="equipment" data-i18n="filterEquipment">معدات / مركبات</option>
          <option value="environment" data-i18n="filterEnvironment">بيئية / جوية</option>
