/* =========================================================
   APP STATE
========================================================= */

let currentLanguage = localStorage.getItem("emergencyPortalLanguage") || null;
let selectedCase = null;


/* =========================================================
   LANGUAGE
========================================================= */

function setLanguage(lang) {

  if (!translations[lang]) {
    lang = "ar";
  }

  currentLanguage = lang;

  localStorage.setItem(
    "emergencyPortalLanguage",
    lang
  );

  const root = document.getElementById("app");

  root.lang = lang;
  root.dir = lang === "en" ? "ltr" : "rtl";

  document.getElementById("languageSelect").value = lang;

  document.querySelectorAll("[data-i18n]").forEach(element => {

    const key = element.dataset.i18n;

    if (translations[lang][key]) {
      element.innerHTML = translations[lang][key];
    }

  });

  document.getElementById("searchInput").placeholder =
    translations[lang].searchPlaceholder;

  renderCases();
  renderContacts();

  document.getElementById("languageSplash")
    .classList.add("hidden");

  closeMenu();
}


/* =========================================================
   CASE RENDERING
========================================================= */

function renderCases() {

  const grid = document.getElementById("casesGrid");

  const search =
    document.getElementById("searchInput").value
      .trim()
      .toLowerCase();

  const category =
    document.getElementById("caseFilter").value;

  const lang = currentLanguage || "ar";

  const filtered = cases.filter(item => {

    const title = item.title[lang].toLowerCase();

    const matchesSearch =
      !search ||
      title.includes(search) ||
      item.title.en.toLowerCase().includes(search) ||
      item.title.ar.toLowerCase().includes(search);

    const matchesCategory =
      category === "all" ||
      item.category === category;

    return matchesSearch && matchesCategory;

  });

  grid.innerHTML = "";

  if (!filtered.length) {

    grid.innerHTML = `
      <div class="no-results">
        ${translations[lang].noResults}
      </div>
    `;

    return;
  }

  filtered.forEach(item => {

    const card = document.createElement("article");

    card.className = "case-card";

    card.onclick = () => openCase(item);

    card.innerHTML = `
      <div class="case-icon">${item.icon}</div>
      <h3>${escapeHTML(item.title[lang])}</h3>
      <small>${escapeHTML(item.box[lang])}</small>
    `;

    grid.appendChild(card);

  });
}


/* =========================================================
   SEARCH
========================================================= */

function filterCases() {
  renderCases();
}


/* =========================================================
   MODAL
========================================================= */

function openCase(item) {

  selectedCase = item;

  const lang = currentLanguage || "ar";

  document.getElementById("modalTitle").textContent =
    item.icon + " " + item.title[lang];

  document.getElementById("modalLocation").textContent =
    " " + item.box[lang];

  const steps = document.getElementById("modalSteps");

  steps.innerHTML = "";

  item.steps[lang].forEach(step => {

    const li = document.createElement("li");

    li.textContent = step;

    steps.appendChild(li);

  });

  const kit = document.getElementById("modalKit");

  kit.innerHTML = "";

  item.kit[lang].forEach(item => {

    const div = document.createElement("div");

    div.className = "kit-item";

    div.textContent = "🩺 " + item;

    kit.appendChild(div);

  });

  document.getElementById("caseModal")
    .classList.add("open");

  document.body.style.overflow = "hidden";
}


function closeModal() {

  document.getElementById("caseModal")
    .classList.remove("open");

  document.body.style.overflow = "";

  selectedCase = null;
}


function outsideModal(event) {

  if (event.target.id === "caseModal") {
    closeModal();
  }

}


/* =========================================================
   CONTACTS
========================================================= */

function renderContacts() {

  const grid = document.getElementById("contactsGrid");

  const lang = currentLanguage || "ar";

  grid.innerHTML = "";

  contacts.forEach(contact => {

    const card = document.createElement("div");

    card.className = "contact-card";

    card.innerHTML = `
      <div class="contact-role">
        ${escapeHTML(contact.role[lang])}
      </div>

      <div class="contact-name">
        ${escapeHTML(contact.name)}
      </div>

      <a
        class="call"
        href="tel:${contact.phone}"
      >
        📞 ${formatPhone(contact.phone)}
      </a>
    `;

    grid.appendChild(card);

  });
}


/* =========================================================
   MOBILE MENU
========================================================= */

function toggleMenu() {

  document
    .getElementById("navLinks")
    .classList.toggle("open");

}


function closeMenu() {

  document
    .getElementById("navLinks")
    .classList.remove("open");

}


/* =========================================================
   HELPERS
========================================================= */

function formatPhone(phone) {

  if (phone.length === 10) {

    return (
      phone.substring(0, 3) +
      " " +
      phone.substring(3, 6) +
      " " +
      phone.substring(6)
    );

  }

  return phone;
}


function escapeHTML(value) {

  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");

}


/* =========================================================
   INITIALIZE
========================================================= */

document.getElementById("year").textContent =
  new Date().getFullYear();

if (currentLanguage) {

  setLanguage(currentLanguage);

} else {

  document
    .getElementById("languageSplash")
    .classList.remove("hidden");

}


/* =========================================================
   KEYBOARD ACCESSIBILITY
========================================================= */

document.addEventListener("keydown", event => {

  if (event.key === "Escape") {

    closeModal();
    closeMenu();

  }

});


/* =========================================================
   CLOSE MOBILE MENU WHEN LINK CLICKED
========================================================= */

document.querySelectorAll(".nav-links a")
  .forEach(link => {

    link.addEventListener("click", closeMenu);

  });


